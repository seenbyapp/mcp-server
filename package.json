{
  "name": "seenby-mcp",
  "version": "1.0.0",
  "description": "AI search visibility MCP connector by Seenby: AI visibility tracking for ChatGPT, Perplexity, Gemini and Google AI answers, with cited pages and answer history.",
  "type": "module",
  "bin": {
    "seenby-mcp": "server/index.js"
  },
  "files": [
    "server",
    "icon.png",
    "manifest.json",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/*.test.mjs",
    "bundle": "mcpb pack . seenby.mcpb"
  },
  "dependencies": {
    "mcp-remote": "0.14.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Seenby",
  "license": "MIT",
  "homepage": "https://seenbyapp.com/developers/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seenbyapp/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/seenbyapp/mcp-server/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "claude",
    "ai-search-visibility",
    "ai-visibility",
    "generative-engine-optimization",
    "geo",
    "ai-overviews",
    "llm-brand-monitoring",
    "brand-mentions",
    "seo"
  ],
  "mcpName": "io.github.seenbyapp/mcp-server",
  "overrides": {
    "tmp": "^0.2.6"
  }
}
